# Set this to your deployed Render backend URL (no trailing slash) when
# deploying to Vercel, e.g.:
#   NEXT_PUBLIC_API_URL=https://todo-api.onrender.com
#
# Leave unset for local dev — requests fall back to relative /api/* paths,
# which next.config.mjs's rewrite proxies to http://localhost:4000.
NEXT_PUBLIC_API_URL=
